{
  "name": "project-copper",
  "private": true,
  "version": "0.1.0",
  "description": "Project Copper — a flash-style stealth scrapping game. Help Dalton strip the school for copper and get it to the white van without Mr. Gravy catching him.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tools/e2e.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "map": "node tools/generate-map.mjs",
    "art": "node tools/render-art.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
